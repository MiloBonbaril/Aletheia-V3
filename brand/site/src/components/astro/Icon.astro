---
/** Petit jeu d'icônes inline (trait 2px, currentColor). */
interface Props {
  name: "arrow" | "twitch" | "youtube" | "discord" | "ear" | "eye" | "memory" | "voice" | "menu" | "close" | "calendar" | "play";
  size?: number;
  label?: string;
}
const { name, size = 24, label } = Astro.props;
const paths: Record<Props["name"], string> = {
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  twitch: '<path d="M4 3h16v11l-5 5h-4l-3 3H6v-3H4z"/><path d="M11 8v4M15 8v4"/>',
  youtube: '<rect x="2.5" y="5" width="19" height="14" rx="4"/><path d="m10 9 5 3-5 3z" fill="currentColor"/>',
  discord: '<path d="M8 6.5c-2 .4-3.3 1-4 1.5C2.5 11 2 14 2.2 17c1.5 1.2 3.2 1.9 4.8 2.3l1-1.8M16 6.5c2 .4 3.3 1 4 1.5 1.5 3 2 6 1.8 9-1.5 1.2-3.2 1.9-4.8 2.3l-1-1.8"/><path d="M7.5 16.5c3 1.4 6 1.4 9 0M8 7.5c2.6-.9 5.4-.9 8 0"/><circle cx="9" cy="12.5" r="1.3" fill="currentColor"/><circle cx="15" cy="12.5" r="1.3" fill="currentColor"/>',
  ear: '<path d="M7 21c0-6 1-12 5-18 4 6 5 12 5 18"/><path d="M10 20c0-4 .6-8 2-11 1.4 3 2 7 2 11"/>',
  eye: '<circle cx="7" cy="13" r="4"/><circle cx="17" cy="13" r="4"/><path d="M11 12.5h2M3 12 1.5 10M21 12l1.5-2"/>',
  memory: '<path d="M12 3v3M12 18v3M3 12h3M18 12h3"/><circle cx="12" cy="12" r="5"/><path d="M12 9.5V12l1.8 1.2"/>',
  voice: '<path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v7a2.5 2.5 0 0 1-2.5 2.5H10l-4.5 4v-4h0A1.5 1.5 0 0 1 4 14.5z"/><path d="M8.5 10h.01M12 10h.01M15.5 10h.01" stroke-width="2.6"/>',
  menu: '<path d="M4 8h16M4 16h16"/>',
  close: '<path d="m6 6 12 12M18 6 6 18"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="15" rx="3"/><path d="M3.5 10h17M8 3v4M16 3v4"/>',
  play: '<path d="M8 5.5v13l11-6.5z" fill="currentColor"/>',
};
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  set:html={paths[name]}
/>
