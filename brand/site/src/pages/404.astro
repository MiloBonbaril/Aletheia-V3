---
import Base from "../layouts/Base.astro";
import symbolRaw from "../assets/brand/aletheia-symbol.svg?raw";
import { inlineSvg } from "../lib/svg";
---
<Base title="Page introuvable">
  <section class="nf wrap">
    <div class="sym" aria-hidden="true"><Fragment set:html={inlineSvg(symbolRaw)} /></div>
    <p class="eyebrow">Erreur 404</p>
    <h1>Même avec ses lunettes, elle ne trouve pas cette page.</h1>
    <a class="btn" href="/">Retour à l'accueil</a>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.5rem;
    padding-block: var(--section);
  }
  .sym {
    width: 8rem;
    padding: 1rem;
    border-radius: 50%;
    background: var(--ble);
    animation: search 3s ease-in-out infinite;
  }
  @keyframes search {
    0%, 100% { rotate: -10deg; }
    50% { rotate: 10deg; }
  }
  h1 {
    font-size: var(--step-4);
    max-width: 18ch;
  }
</style>
