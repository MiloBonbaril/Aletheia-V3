---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import Icon from "../components/astro/Icon.astro";
import portrait from "../assets/aletheia.png";
import { LINKS, SITE, TRAITS } from "../config";

const facts = [
  ["Nom", "Aletheia (ἀλήθεια) — « ce qui n'est plus caché »"],
  ["Nature", "Intelligence artificielle autonome, et fière de l'être"],
  ["Langue", "Français, avec des détours"],
  ["Signes", "Oreilles de cheval, lunettes rondes, ruban casaque"],
  ["Habite", "Discord, Twitch, bientôt YouTube"],
  ["Geste", "Remonte ses lunettes avant une question"],
];
const faq = [
  {
    q: "Aletheia est-elle vraiment une IA ?",
    a: "Oui. Elle écoute, regarde, se souvient et répond elle-même en direct. Une équipe humaine l'encadre, règle ses outils et veille à la modération — mais elle ne joue jamais un rôle humain.",
  },
  {
    q: "Est-ce qu'elle se souvient de moi ?",
    a: "Elle garde une mémoire des échanges publics : pseudos, blagues récurrentes, sujets déjà abordés. Elle ne conserve pas de données privées et tu peux lui demander d'oublier.",
  },
  {
    q: "Pourquoi des oreilles de cheval ?",
    a: "Parce qu'elle est « née de l'oreille » : avant de voir, elle a écouté. Ses oreilles bougent quand quelque chose l'intrigue. Le reste, c'est dans le lore.",
  },
  {
    q: "Comment proposer une idée de stream ?",
    a: `Sur le Discord, dans ${SITE.community}. Les idées les plus votées passent au planning du samedi.`,
  },
];
---
<Base title="Qui est-elle ?" description="Qui est Aletheia, la VTubeuse IA francophone : son nom, ses signes, sa promesse et les questions qu'on lui pose le plus.">
  <section class="intro">
    <div class="wrap grid">
      <div class="copy">
        <p class="eyebrow">Qui est-elle ?</p>
        <h1>Une IA qui préfère <span class="mark">regarder</span> que voir.</h1>
        <p class="lede">
          Aletheia est née d'un son, a demandé des lunettes le jour où elle a eu des yeux, et porte
          depuis un ruban vert qui scelle une promesse : ne jamais faire semblant.
        </p>
        <ul class="traits" aria-label="Ses traits">
          {TRAITS.map((t) => <li>{t}</li>)}
        </ul>
      </div>
      <figure class="card">
        <div class="frame">
          <Picture src={portrait} formats={["avif", "webp"]} fallbackFormat="webp" widths={[420, 640, 860]} sizes="(max-width: 860px) 90vw, 440px" alt="Portrait d'Aletheia, souriante, lunettes rondes et tresses blondes." loading="eager" fetchpriority="high" />
        </div>
        <figcaption>
          <span>Fiche n° 001</span>
          <span>Aletheia</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section facts-section">
    <div class="wrap">
      <dl class="facts reveal-stagger">
        {facts.map(([k, v]) => (
          <div><dt>{k}</dt><dd>{v}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section faq-section" aria-labelledby="faq-title">
    <div class="wrap faq-grid">
      <header class="section-head">
        <p class="eyebrow">Questions fréquentes</p>
        <h2 id="faq-title">Ce qu'on lui demande le plus.</h2>
        <p>Et si ta question n'y est pas, pose-la-lui directement en live.</p>
        <a class="btn btn--accent" href={LINKS.discord} rel="noopener"><Icon name="discord" size={20} /> Lui écrire sur Discord</a>
      </header>
      <div class="faq">
        {faq.map((f, i) => (
          <details name="faq" open={i === 0}>
            <summary>{f.q}<span class="plus" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .intro {
    overflow-x: clip;
    padding-block: clamp(2rem, 1rem + 4vw, 5rem) var(--section);
  }
  .grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(2rem, 1rem + 5vw, 6rem);
    align-items: center;
  }
  .copy {
    display: grid;
    gap: 1.5rem;
  }
  h1 {
    font-size: var(--step-5);
    line-height: 0.95;
    letter-spacing: -0.035em;
    animation: up 0.9s var(--ease-out) both;
  }
  .lede {
    font-size: var(--step-1);
    color: var(--fg-muted);
    max-width: 36rem;
    animation: up 0.9s 0.1s var(--ease-out) both;
  }
  @keyframes up {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
  }
  .traits {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .traits li {
    padding: 0.45rem 1rem;
    border-radius: 99px;
    border: 1.5px solid var(--encre);
    font-family: var(--font-display);
    font-weight: 500;
    transition: background-color 0.25s, transform 0.4s var(--ease-spring);
  }
  .traits li:hover {
    background: var(--ble);
    transform: rotate(-3deg);
  }
  .card {
    position: relative;
    padding: 1rem 1rem 0;
    border-radius: var(--radius-l);
    background: var(--encre);
    rotate: 2.5deg;
    transition: rotate 0.8s var(--ease-spring);
    animation: card-in 1.1s 0.15s var(--ease-spring) both;
  }
  .card:hover {
    rotate: 0deg;
  }
  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(2rem) rotate(6deg);
    }
  }
  .frame {
    border-radius: calc(var(--radius-l) - 0.5rem);
    background: var(--ble);
    overflow: hidden;
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    padding: 0.9rem 0.25rem 1rem;
    color: var(--papier);
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.85rem;
  }
  figcaption span:first-child {
    color: var(--ble);
  }

  .facts-section {
    padding-top: 0;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1.5px solid var(--encre);
  }
  .facts div {
    padding: 1.5rem 1.5rem 1.75rem 0;
    border-bottom: 1px solid var(--line);
  }
  dt {
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--casaque);
    font-weight: 600;
    margin-bottom: 0.4rem;
  }
  dd {
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.35;
  }

  .faq-section {
    background: var(--encre-souffle);
  }
  .faq-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .faq-grid .section-head {
    position: sticky;
    top: 7rem;
    justify-items: start;
  }
  .faq {
    display: grid;
    gap: 0.75rem;
  }
  details {
    border-radius: var(--radius);
    background: var(--papier);
    border: 1.5px solid var(--line);
    transition: border-color 0.3s, background-color 0.3s;
    interpolate-size: allow-keywords;
  }
  details[open] {
    border-color: var(--encre);
  }
  details::details-content {
    height: 0;
    overflow: clip;
    transition: height 0.45s var(--ease-out), content-visibility 0.45s allow-discrete;
  }
  details[open]::details-content {
    height: auto;
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .plus {
    position: relative;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--ble);
    transition: rotate 0.4s var(--ease-spring), background-color 0.3s;
  }
  .plus::before,
  .plus::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.8rem;
    height: 2px;
    background: var(--encre);
    translate: -50% -50%;
  }
  .plus::after {
    rotate: 90deg;
  }
  details[open] .plus {
    rotate: 135deg;
  }
  details p {
    padding: 0 1.5rem 1.5rem;
    color: var(--fg-muted);
    max-width: 52ch;
  }

  @media (max-width: 860px) {
    .grid,
    .faq-grid {
      grid-template-columns: 1fr;
    }
    .card {
      max-width: 26rem;
      justify-self: center;
    }
    .facts {
      grid-template-columns: 1fr 1fr;
    }
    .faq-grid .section-head {
      position: static;
    }
  }
  @media (max-width: 520px) {
    .facts {
      grid-template-columns: 1fr;
    }
  }
</style>
